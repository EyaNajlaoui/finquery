# Copy this file to .env and fill in your key. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# Optional: use a Qdrant server instead of the local mode (set automatically in Docker Compose)
# QDRANT_URL=http://localhost:6333

# Optional: hide the Hugging Face symlink warning on Windows (the cache works without symlinks)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
